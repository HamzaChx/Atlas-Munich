OPENAI_API_KEY=your_openai_api_key_here
# Runtime role: atlas_app. Set in Vercel; never expose as NEXT_PUBLIC_.
DATABASE_URL=postgresql://atlas_app:password@host/database?sslmode=require
# Owner role: local migration/admin use only. Never set in Vercel.
DIRECT_DATABASE_URL=postgresql://database_owner:password@host/database?sslmode=require
